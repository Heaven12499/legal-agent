# Python
.venv/
__pycache__/
*.pyc
.conda-pkgs/
.pip-cache/

# IDE
.idea/

# 检索索引产物（M1 建索引后落盘的文件不入库）
*.index
*.faiss

# 切分派生产物（chunks.json 可由 python -m backend.app.core.chunking 重新生成）
corpus/chunks.json

# 模型文件（由 backend.scripts.download_model 下载，不入库）
models/

# 密钥（M3 agent 的 DeepSeek key，绝不能入库）
.env

# 前端（M4 分离：依赖与构建产物由 npm 生成，不入库）
frontend/node_modules/
frontend/dist/

# 会话库（运行时数据，不入库）
data/

# 公开合同导入与本地 OCR 的临时中间产物
tmp/
sample_contracts/public_disclosed_deidentified/

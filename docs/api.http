# JetBrains HTTP Client 手工接口示例。
# 将用户名、密码改为 .env 中 INIT_USERNAME / INIT_PASSWORD，先执行登录请求。
@baseUrl = http://127.0.0.1:8000
@username = admin
@password = change-me

### 登录并保存 JWT
# @name login
POST {{baseUrl}}/api/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

> {% client.global.set("auth_token", response.body.token); %}

### 查询当前用户
GET {{baseUrl}}/api/me
Authorization: Bearer {{auth_token}}

### 新建会话并提问
POST {{baseUrl}}/api/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "被裁员有没有赔偿",
  "session_id": "test-session-1"
}

### 异步提交合同审查（推荐给长文本；立即返回 job_id）
# @name createReview
POST {{baseUrl}}/api/reviews
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "请审查这份合同中的风险条款，并为每个结论检索法律依据",
  "session_id": "review-session-1",
  "contract": "第一条 甲方逾期付款不承担任何责任。",
  "contract_name": "采购合同.txt",
  "max_attempts": 2
}

> {% client.global.set("review_job_id", response.body.job_id); %}

### 查询异步审查进度/结果
GET {{baseUrl}}/api/reviews/{{review_job_id}}
Authorization: Bearer {{auth_token}}

### 仅当任务最终失败时人工重试
POST {{baseUrl}}/api/reviews/{{review_job_id}}/retry
Authorization: Bearer {{auth_token}}

### 继续追问
POST {{baseUrl}}/api/chat
Authorization: Bearer {{auth_token}}
Content-Type: application/json

{
  "message": "那经济补偿具体按什么标准算",
  "session_id": "test-session-1"
}

### 查询会话历史
GET {{baseUrl}}/api/chat/sessions/test-session-1/history
Authorization: Bearer {{auth_token}}

### 删除测试会话
DELETE {{baseUrl}}/api/chat/sessions/test-session-1
Authorization: Bearer {{auth_token}}

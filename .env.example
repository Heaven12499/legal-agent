# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会提交）
# 注意：真实 key 只放 .env，绝不写进本模板文件（本文件会提交到 git）

# DeepSeek 官方端点（OpenAI 兼容）
OPENAI_BASE_URL=https://api.deepseek.com

# DeepSeek 官方 API key（必填，填你自己的）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 模型名（deepseek-chat 支持 function calling）
LLM_MODEL=deepseek-chat

# 二阶段精排：设为 1 启用；默认 0，保持 RRF 融合排序
RERANK=0

# ---- 用户认证（M9，可选配）----
# 初始用户（启动时 seed，幂等）：用于首次登录 + 接管历史未归属会话
INIT_USERNAME=admin
# 建议自己设一个强密码；留空则启动时自动生成随机密码并打印一次
INIT_PASSWORD=
# JWT 签名密钥：建议用长随机串（>=32 字节）。留空则首次生成并持久化到 data/.jwt_secret
JWT_SECRET=
# token 有效期（秒），默认 7 天
JWT_EXPIRE_SECONDS=604800

# ---- 生产数据库 / 队列 / 限流 ----
POSTGRES_PASSWORD=replace-with-a-long-random-password
RABBITMQ_PASSWORD=replace-with-a-long-random-password
# Compose 自动注入 DB_HOST/RABBITMQ_HOST；非 Compose 开发可直接提供以下两个 URL：
DATABASE_URL=
CELERY_BROKER_URL=
REDIS_URL=redis://localhost:6379/0
WORKER_CONCURRENCY=2
REVIEW_JOB_LEASE_SECONDS=3600
REVIEW_SOFT_TIME_LIMIT=1200
REVIEW_HARD_TIME_LIMIT=1260
REVIEW_RATE_LIMIT=5
MAX_UPLOAD_BYTES=10485760
LLM_TIMEOUT=60
